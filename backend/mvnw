#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WRAPPER_JAR="$ROOT/.mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Maven Wrapper JAR is missing. Run the wrapper bootstrap described in README.md." >&2
  exit 1
fi
exec java -Dmaven.multiModuleProjectDirectory="$ROOT" -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
